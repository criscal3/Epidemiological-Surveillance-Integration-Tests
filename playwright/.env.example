# Copie este archivo como .env y complete las claves. No versione .env.
# Frontend local (yarn start) que hace de proxy hacia el backend.
SPA_URL=http://localhost:8080

ADMIN_USER=admin
ADMIN_PASS=
MEDICO_USER=medico.prueba
MEDICO_PASS=
EPI_USER=epi.prueba
EPI_PASS=
SIN_ACCESO_USER=sin.acceso
SIN_ACCESO_PASS=

# Ubicación de sesión (UUID de la ubicación donde se registraron las atenciones).
LOCATION_UUID=

# Pacientes sintéticos registrados en el módulo de registro.
DNI_01=
DNI_02=

# Centro poblado del lugar probable de infección (con coordenadas cargadas).
# CENTER_QUERY es lo que se escribe en el buscador; CENTER_NAME, el texto de la opción.
CENTER_QUERY=
CENTER_NAME=

# Valores de content (no cambian salvo que se use otro diagnóstico o prueba).
EVENT_CONCEPT_UUID=094d1472-74d0-4f3b-9ba2-3958cf0edea8
LAB_TEST_CONCEPT_UUID=450efcc9-ddcd-4ecd-b999-e585ccb583eb
# Causa de defunción usada en IT-06 (por defecto, el mismo diagnóstico).
CAUSE_OF_DEATH_CONCEPT_UUID=094d1472-74d0-4f3b-9ba2-3958cf0edea8
